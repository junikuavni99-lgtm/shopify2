<section class="sec">
  <div class="wrap">
    <div class="sec__head"><p class="eyebrow">Your selection</p><h1 class="h2">Bag</h1></div>
    {% if cart.item_count > 0 %}
      <form action="{{ routes.cart_url }}" method="post" novalidate>
        {% for item in cart.items %}
          <div class="line">
            {% if item.image %}<img src="{{ item.image | image_url: width: 200 }}" alt="{{ item.title | escape }}" width="200" height="200">{% endif %}
            <div style="flex:1">
              <a href="{{ item.url }}" style="font-family:var(--display);font-size:18px">{{ item.product.title }}</a>
              <p class="muted" style="font-size:13px;margin:4px 0 0">{{ item.variant.title }} &middot; {{ item.final_price | money }}</p>
            </div>
            <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="max-width:90px">
            <a class="muted" href="{{ item.url_to_remove }}" style="font-size:12px">Remove</a>
          </div>
        {% endfor %}
        <div class="cart__foot">
          <div>
            <p class="eyebrow">Total</p>
            <p class="price" style="font-size:28px;margin:6px 0 0">{{ cart.total_price | money }}</p>
          </div>
          <div style="display:flex;gap:12px">
            <button class="btn btn--ghost" type="submit" name="update">Update</button>
            <button class="btn" type="submit" name="checkout">Checkout</button>
          </div>
        </div>
      </form>
    {% else %}
      <p class="empty">Your bag is empty. <a href="{{ routes.all_products_collection_url }}" style="color:var(--gold)">Browse the boutique</a>.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{ "name": "Cart", "settings": [] }
{% endschema %}
