<section class="sec" id="boutique">
  <div class="wrap">
    <div class="sec__head">
      <p class="eyebrow">Boutique</p>
      <h2 class="h2">{{ section.settings.heading }}</h2>
      <p>{{ section.settings.subheading }}</p>
    </div>
    {%- assign coll = collections[section.settings.collection] -%}
    {%- if coll != blank and coll.products_count > 0 -%}
      {%- assign items = coll.products -%}
    {%- else -%}
      {%- assign items = collections.all.products -%}
    {%- endif -%}
    {% if items.size > 0 %}
      <div class="grid">
        {% for product in items limit: section.settings.count %}
          {% render 'product-card', product: product %}
        {% endfor %}
      </div>
    {% else %}
      <p class="empty">No products found.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Boutique" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Everything in the house collection, ready to add to your bag." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "count", "label": "Products", "min": 4, "max": 24, "step": 4, "default": 12 }
  ],
  "presets": [{ "name": "Featured products" }]
}
{% endschema %}
