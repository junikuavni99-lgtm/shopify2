{%- assign variant = product.selected_or_first_available_variant -%}

<div class="anno">{{ section.settings.announcement }}</div>

<div class="wrap">
  <section class="pdp">
    <div class="pdp__media">
      <div class="pdp__main">
        {% if product.featured_image %}
          <img id="PdpMain" src="{{ product.featured_image | image_url: width: 1200 }}"
               alt="{{ product.featured_image.alt | default: product.title | escape }}"
               width="1200" height="1500">
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="pdp__thumbs">
          {% for image in product.images limit: 6 %}
            <button class="thumb {% if forloop.first %}is-active{% endif %}" type="button"
                    data-src="{{ image | image_url: width: 1200 }}"
                    aria-label="View image {{ forloop.index }}">
              <img src="{{ image | image_url: width: 300 }}"
                   alt="{{ image.alt | default: product.title | escape }}" loading="lazy"
                   width="300" height="300">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="pdp__info">
      {% if product.type != blank %}<p class="eyebrow">{{ product.type }}</p>{% endif %}
      <h1 class="h2">{{ product.title }}</h1>

      {% if section.settings.show_rating %}
        <div class="rating">
          <span class="stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
          <strong>{{ section.settings.rating_value }}</strong>
          <span class="muted">{{ section.settings.rating_label }}</span>
        </div>
      {% endif %}

      <div class="pdp__price">
        <span class="price price--lg">{{ variant.price | money }}</span>
        {% if variant.compare_at_price > variant.price %}
          <span class="was">{{ variant.compare_at_price | money }}</span>
          <span class="tag">Save {{ variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price }}%</span>
        {% endif %}
      </div>
      <p class="fineprint muted">Incl. VAT. Free worldwide shipping &mdash; no extra fees at checkout.</p>

      {% form 'product', product, class: 'pdp__form' %}
        {% if product.has_only_default_variant == false %}
          {% for option in product.options_with_values %}
            <div class="optgroup">
              <p class="optlabel">{{ option.name }}</p>
              <div class="opts">
                {% for value in option.values %}
                  <span class="opt {% if option.selected_value == value %}is-active{% endif %}">{{ value }}</span>
                {% endfor %}
              </div>
            </div>
          {% endfor %}
          <label class="field">Select option
            <select name="id" id="PdpVariant">
              {% for v in product.variants %}
                <option value="{{ v.id }}" data-price="{{ v.price | money }}"
                        {% unless v.available %}disabled{% endunless %}
                        {% if v.id == variant.id %}selected{% endif %}>
                  {{ v.title }} &mdash; {{ v.price | money }}
                </option>
              {% endfor %}
            </select>
          </label>
          <p class="fineprint muted">Oversized fit &mdash; between sizes, we recommend sizing down.</p>
        {% else %}
          <input type="hidden" name="id" value="{{ variant.id }}">
        {% endif %}

        <div class="buyrow">
          <div class="qty">
            <button type="button" class="qty__btn" data-qty="-1" aria-label="Decrease quantity">&minus;</button>
            <input type="number" name="quantity" id="PdpQty" value="1" min="1" inputmode="numeric" aria-label="Quantity">
            <button type="button" class="qty__btn" data-qty="1" aria-label="Increase quantity">+</button>
          </div>
          <button class="btn btn--lg" type="submit" {% unless variant.available %}disabled{% endunless %}>
            {% if variant.available %}Add to Cart &mdash; {{ variant.price | money }}{% else %}Sold out{% endif %}
          </button>
        </div>
      {% endform %}

      <ul class="assure">
        <li>Free worldwide shipping, dispatched in 24h</li>
        <li>30-day money-back guarantee</li>
        <li>Secure encrypted checkout</li>
      </ul>

      {% if product.description != blank %}
        <div class="pdp__desc">{{ product.description }}</div>
      {% endif %}
    </div>
  </section>

  <!-- feature badges -->
  <section class="sec sec--tight feats">
    {% for i in (1..3) %}
      {% assign t = 'feat_' | append: i | append: '_title' %}
      {% assign c = 'feat_' | append: i | append: '_text' %}
      {% if section.settings[t] != blank %}
        <div class="feat">
          <span class="feat__dot" aria-hidden="true"></span>
          <h3>{{ section.settings[t] }}</h3>
          <p class="muted">{{ section.settings[c] }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </section>

  <!-- lifestyle benefits -->
  <section class="sec">
    <div class="sec__head">
      <p class="eyebrow">{{ section.settings.life_eyebrow }}</p>
      <h2 class="h2">{{ section.settings.life_title }}</h2>
      <p>{{ section.settings.life_text }}</p>
    </div>
    <div class="lifegrid">
      {% for i in (1..2) %}
        {% assign img = 'life_' | append: i | append: '_image' %}
        {% assign t = 'life_' | append: i | append: '_title' %}
        {% assign c = 'life_' | append: i | append: '_text' %}
        <article class="lifecard">
          <div class="lifecard__img">
            {% if section.settings[img] != blank %}
              <img src="{{ section.settings[img] | image_url: width: 1200 }}"
                   alt="{{ section.settings[t] | escape }}" loading="lazy" width="1200" height="900">
            {% elsif product.images[i] %}
              <img src="{{ product.images[i] | image_url: width: 1200 }}"
                   alt="{{ section.settings[t] | escape }}" loading="lazy" width="1200" height="900">
            {% endif %}
          </div>
          <div class="lifecard__body">
            <h3>{{ section.settings[t] }}</h3>
            <p class="muted">{{ section.settings[c] }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  <!-- specs + care -->
  <section class="sec specs">
    <div>
      <h2 class="h2">Specifications</h2>
      <dl class="spectable">
        {% assign rows = section.settings.specs | newline_to_br | split: '<br />' %}
        {% for row in rows %}
          {% assign parts = row | strip | split: '|' %}
          {% if parts.size == 2 %}
            <div class="specrow">
              <dt>{{ parts[0] | strip }}</dt>
              <dd class="muted">{{ parts[1] | strip }}</dd>
            </div>
          {% endif %}
        {% endfor %}
      </dl>
    </div>
    <div>
      <h2 class="h2">Fabric care</h2>
      <ul class="carelist">
        {% assign care = section.settings.care | newline_to_br | split: '<br />' %}
        {% for c in care %}
          {% assign line = c | strip %}
          {% if line != blank %}<li class="muted">{{ line }}</li>{% endif %}
        {% endfor %}
      </ul>
    </div>
  </section>

  <!-- trust -->
  <section class="sec">
    <div class="trust">
      <h2 class="h2">Ordering with zero risk</h2>
      <div class="trust__grid">
        <div>
          <h3>Secure checkout</h3>
          <p>256-bit encrypted payments &mdash; Visa, Mastercard, PayPal, Apple Pay and Klarna.</p>
        </div>
        <div>
          <h3>Shipping times</h3>
          <p>Dispatch within 24h. EU 3&ndash;5 days, UK &amp; US 5&ndash;7 days, rest of world 5&ndash;9 days. Always tracked, always free.</p>
        </div>
        <div>
          <h3>30-day guarantee</h3>
          <p>Not the cosiest thing you own? Return it within 30 days for a full refund, return label included.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="sec">
    <h2 class="h2">Frequently asked questions</h2>
    <div class="faq">
      {% for i in (1..5) %}
        {% assign q = 'faq_' | append: i | append: '_q' %}
        {% assign a = 'faq_' | append: i | append: '_a' %}
        {% if section.settings[q] != blank %}
          <details class="faq__item">
            <summary>{{ section.settings[q] }}</summary>
            <div class="faq__a muted">{{ section.settings[a] }}</div>
          </details>
        {% endif %}
      {% endfor %}
    </div>
  </section>

  <!-- reviews -->
  <section class="sec reviews">
    <div class="reviews__head">
      <div>
        <h2 class="h2">Customer reviews</h2>
        <p class="muted">Verified reviews with photos from customers, collected after delivery.</p>
      </div>
      <a class="btn btn--ghost" href="{{ shop.url }}/pages/contact">Write a review</a>
    </div>
    <div class="reviews__body">
      <aside class="reviews__side">
        <p class="price price--lg">&mdash;</p>
        <p class="fineprint muted">No reviews yet</p>
        <div class="rfilters">
          <button type="button" class="rfilter is-active">All ratings</button>
          {% for i in (1..5) %}
            {% assign star = 6 | minus: i %}
            <button type="button" class="rfilter">
              <span>{{ star }} star</span><span class="rbar"></span><span class="rcount">0</span>
            </button>
          {% endfor %}
        </div>
      </aside>
      <div class="reviews__grid">
        {% for i in (1..3) %}
          <article class="rcard">
            <span class="stars stars--empty">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
            <div class="rcard__ph">Photo review</div>
            <p class="muted">No reviews yet</p>
          </article>
        {% endfor %}
      </div>
    </div>
    <p class="muted fineprint">Be the first to review this product &mdash; photo reviews from real customers will appear here.</p>
  </section>
</div>

<!-- sticky mobile add to cart -->
<div class="stickybar">
  <div class="stickybar__in">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy" width="120" height="120">
    {% endif %}
    <div class="stickybar__txt">
      <p class="stickybar__title">{{ product.title }}</p>
      <p class="price">{{ variant.price | money }}</p>
    </div>
    <button class="btn" type="button" id="StickyAdd" {% unless variant.available %}disabled{% endunless %}>
      {% if variant.available %}Add to Cart{% else %}Sold out{% endif %}
    </button>
  </div>
</div>

{% schema %}
{
  "name": "Product",
  "settings": [
    { "type": "text", "id": "announcement", "label": "Announcement bar", "default": "Free Worldwide Shipping & 30-Day Money-Back Guarantee" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "rating_value", "label": "Rating value", "default": "4.9/5" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "Verified customer rating" },

    { "type": "header", "content": "Feature badges" },
    { "type": "text", "id": "feat_1_title", "label": "Feature 1 title", "default": "Ultra-Soft Plush Fabric" },
    { "type": "textarea", "id": "feat_1_text", "label": "Feature 1 text", "default": "Double-sided sherpa and micro-fleece that stays soft wash after wash." },
    { "type": "text", "id": "feat_2_title", "label": "Feature 2 title", "default": "Oversized Freedom of Movement" },
    { "type": "textarea", "id": "feat_2_text", "label": "Feature 2 text", "default": "Roomy drop shoulders and a floor-length cut designed for curves." },
    { "type": "text", "id": "feat_3_title", "label": "Feature 3 title", "default": "Easy Care" },
    { "type": "textarea", "id": "feat_3_text", "label": "Feature 3 text", "default": "Machine wash cold, tumble dry low. No pilling, no special treatment." },

    { "type": "header", "content": "Lifestyle benefits" },
    { "type": "text", "id": "life_eyebrow", "label": "Eyebrow", "default": "Made for slow evenings" },
    { "type": "text", "id": "life_title", "label": "Title", "default": "The warmth of your duvet, in something you can actually wear" },
    { "type": "textarea", "id": "life_text", "label": "Intro", "default": "One layer that replaces the robe, the throw and the extra pair of socks - so settling in takes exactly one movement." },
    { "type": "image_picker", "id": "life_1_image", "label": "Card 1 image" },
    { "type": "text", "id": "life_1_title", "label": "Card 1 title", "default": "Quiet mornings, kept warm" },
    { "type": "textarea", "id": "life_1_text", "label": "Card 1 text", "default": "Blanket-weight plush holds heat around your shoulders and knees, so cold rooms stop dictating your morning." },
    { "type": "image_picker", "id": "life_2_image", "label": "Card 2 image" },
    { "type": "text", "id": "life_2_title", "label": "Card 2 title", "default": "Movie nights without the shuffle" },
    { "type": "textarea", "id": "life_2_text", "label": "Card 2 text", "default": "Floor-length coverage and a deep pocket mean nothing slips off when you curl up, stretch out or get up for more tea." },

    { "type": "header", "content": "Specifications & care" },
    { "type": "textarea", "id": "specs", "label": "Specs (one per line: Label | Value)", "default": "Fabric | 260 GSM double-sided plush: sherpa outer, micro-fleece lining\nFit | Oversized, true plus-size grading (1X-5X)\nLength | Floor-length nightgown cut, 138-148 cm depending on size\nDetails | Lined hood, deep kangaroo pocket, ribbed cuffs\nWeight | Approx. 1.1 kg - blanket-weight warmth\nOrigin | Ethically made, OEKO-TEX certified fabric" },
    { "type": "textarea", "id": "care", "label": "Care instructions (one per line)", "default": "Machine wash cold on a gentle cycle with like colours.\nTumble dry low or line dry - never iron the plush face.\nSkip fabric softener to keep the pile fluffy.\nWash separately for the first cycle to set the fibres." },

    { "type": "header", "content": "FAQ" },
    { "type": "text", "id": "faq_1_q", "label": "Q1", "default": "How do I choose my size?" },
    { "type": "textarea", "id": "faq_1_a", "label": "A1", "default": "Every size is cut oversized on purpose. If you usually wear 1X-2X, take 2X for a relaxed drape or 1X for a lighter volume. Between sizes? Size down." },
    { "type": "text", "id": "faq_2_q", "label": "Q2", "default": "How should I wash it?" },
    { "type": "textarea", "id": "faq_2_a", "label": "A2", "default": "Machine wash cold on a gentle cycle, tumble dry low or hang to dry. No fabric softener, no ironing." },
    { "type": "text", "id": "faq_3_q", "label": "Q3", "default": "How long does shipping take?" },
    { "type": "textarea", "id": "faq_3_a", "label": "A3", "default": "Free worldwide shipping on every order. Dispatch within 24 hours on business days; delivery is typically 3-5 days in the EU and 5-9 days worldwide, with tracking." },
    { "type": "text", "id": "faq_4_q", "label": "Q4", "default": "What if it doesn't work for me?" },
    { "type": "textarea", "id": "faq_4_a", "label": "A4", "default": "You have 30 days to return it for a full refund - worn, washed or unopened. We cover the return label." },
    { "type": "text", "id": "faq_5_q", "label": "Q5", "default": "Is it warm enough for cold rooms?" },
    { "type": "textarea", "id": "faq_5_a", "label": "A5", "default": "Yes. At 260 GSM with a blanket-weight drape it traps heat like a duvet you can walk in." }
  ]
}
{% endschema %}
