{%- assign variant = product.selected_or_first_available_variant -%}
<div class="wrap pdp">
  <div class="pdp__media">
    {% if product.featured_image %}
      <img src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1200" height="1200">
    {% endif %}
  </div>
  <div>
    {% if product.type != blank %}<p class="eyebrow">{{ product.type }}</p>{% endif %}
    <h1 class="h2">{{ product.title }}</h1>
    <p class="price" style="font-size:28px;margin:16px 0">{{ variant.price | money }}</p>
    <div class="pdp__desc">{{ product.description }}</div>
    {% form 'product', product %}
      {% if product.has_only_default_variant == false %}
        <label class="field">Variant
          <select name="id">
            {% for v in product.variants %}
              <option value="{{ v.id }}" {% unless v.available %}disabled{% endunless %} {% if v.id == variant.id %}selected{% endif %}>{{ v.title }} &mdash; {{ v.price | money }}</option>
            {% endfor %}
          </select>
        </label>
      {% else %}
        <input type="hidden" name="id" value="{{ variant.id }}">
      {% endif %}
      <label class="field">Quantity
        <input type="number" name="quantity" value="1" min="1" style="max-width:120px">
      </label>
      <button class="btn" type="submit" {% unless variant.available %}disabled{% endunless %}>
        {% if variant.available %}Add to bag{% else %}Sold out{% endif %}
      </button>
    {% endform %}
  </div>
</div>
{% schema %}
{ "name": "Product", "settings": [] }
{% endschema %}
