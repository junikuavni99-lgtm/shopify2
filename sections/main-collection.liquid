<section class="sec">
  <div class="wrap">
    <div class="sec__head">
      <p class="eyebrow">Collection</p>
      <h1 class="h2">{{ collection.title }}</h1>
      {% if collection.description != blank %}<p>{{ collection.description | strip_html | truncate: 220 }}</p>{% endif %}
    </div>
    {% if collection.products.size > 0 %}
      <div class="grid">
        {% for product in collection.products %}{% render 'product-card', product: product %}{% endfor %}
      </div>
      {% if paginate.pages > 1 %}<p style="margin-top:30px">{{ paginate | default_pagination }}</p>{% endif %}
    {% else %}
      <p class="empty">No products found.</p>
    {% endif %}
  </div>
</section>
{% schema %}
{ "name": "Collection", "settings": [] }
{% endschema %}
